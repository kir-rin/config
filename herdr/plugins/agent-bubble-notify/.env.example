# 이 파일을 `herdr plugin config-dir yh.agent-bubble-notify` 가 알려 주는 폴더에 .env 로 복사해서 고친다.

# AgentBot 데몬 주소(기본 http://127.0.0.1:47891)
#AGENT_BUBBLE_URL=http://127.0.0.1:47891

# 목소리: animalese = 말풍선 글을 동물의 숲 말투로 읽기(PyAnimalese — 처음에 ~/.local/share/pyanimalese 로 받음, uv·ffmpeg 필요), off = 안 읽음
#AGENT_BUBBLE_VOICE=animalese
# 높은 목소리
#AGENT_BUBBLE_VOICE_HIGH=0

# 효과음(목소리 앞에): 파일 경로(afplay 가 트는 aiff·mp3·wav 등) 또는 off.
# 비우면 목소리가 켜져 있을 땐 효과음 없음, 꺼져 있을 땐 macOS 기본 소리(Glass·Funk)
#AGENT_BUBBLE_SOUND_DONE=/System/Library/Sounds/Glass.aiff
#AGENT_BUBBLE_SOUND_BLOCKED=/System/Library/Sounds/Funk.aiff

# 말풍선 문구. {title} = 탭 제목(터미널 제목), {agent} = claude·codex 등
#AGENT_BUBBLE_TEXT_DONE=✅ {title} 끝났어요
#AGENT_BUBBLE_TEXT_BLOCKED=⚠️ {title} 확인이 필요해요

# 말풍선 유지 시간(초). 0 = 누르거나 그 pane 을 볼 때까지 남김, 3 = 3초 뒤 사라짐(1–86400). 주면 아래 오래된 알림 치우기보다 우선
#AGENT_BUBBLE_TTL_DONE=0
#AGENT_BUBBLE_TTL_BLOCKED=0
# 오래된 끝난 알림 치우기(분): 위 TTL_DONE 이 0 일 때 끝난 알림을 이만큼 뒤 저절로 닫는다(0 = 끔, 최대 1440). 입력 대기 알림은 안 치운다
#AGENT_BUBBLE_DONE_MAX_AGE_MIN=120

# 캐릭터 한 줄: AgentBot 이 지금 고른 캐릭터의 말투로 「무엇을 끝냈나·무엇을 묻나」를 한 문장으로 만들어 말풍선을 바꾸고, 그 문장을 읽는다
# (가벼운 모델 한 번 — AgentBot 의 경량 모델 설정. 몇 초 걸린다). off 면 아래 요약만
#AGENT_BUBBLE_CHARACTER_LINE=on

# 요약(캐릭터 한 줄이 나오기 전·실패했을 때 본문): 끝났으면 마지막 답, 입력 대기면 승인 기다리는 도구(Claude Code 세션 기록에서). off 로 끄기
#AGENT_BUBBLE_SUMMARY=on
#AGENT_BUBBLE_SUMMARY_CHARS=280
# 세션 기록을 찾을 Claude 설정 폴더(: 로 여럿). 기본은 CLAUDE_CONFIG_DIR 과 ~/.claude*
#AGENT_BUBBLE_CLAUDE_DIRS=

# 상태가 이만큼(ms) 그대로일 때만 알린다(잠깐 done 이었다 바로 working 으로 가는 깜빡임 거르기)
#AGENT_BUBBLE_DELAY_MS=1000

# 보고 있는 pane(포커스 + 터미널이 맨 앞)이면 알리지 않음. 1 이면 그래도 알림
#AGENT_BUBBLE_NOTIFY_FOCUSED=0

# 말풍선 머리줄 칩 「[컴퓨터] 프로젝트 · agent」. 이 컴퓨터 이름(비우면 짧은 호스트 이름 — 아래 매핑이 있으면 그 이름)
#AGENT_BUBBLE_SOURCE_LABEL=집
# 컴퓨터 이름·색 맞추기: key:이름[:색] 을 쉼표로. key = 저장 머신 label(herdr machine list)·local(이 컴퓨터)·호스트 이름,
# 색 = blue|purple|green|orange|pink|gray. 같은 컴퓨터가 어느 맥에서 보든 같은 이름·색이 되게 양쪽 .env 에 같은 줄을 둔다.
# 없으면 이 컴퓨터 blue, 저장 머신은 label 그대로 + 이름에서 고른 색
#AGENT_BUBBLE_MACHINE_NAMES=home:집:blue,company:회사:purple,local:집:blue

# 끝난 세션 말풍선의 [답하기](말풍선에 쓴 말을 그 세션에 프롬프트로 — herdr-bridge.mjs 가 보낸다). off 면 [세션으로 가기]만
#AGENT_BUBBLE_REPLY=on

# 끄기/켜기(토글 액션이 더 우선)
#AGENT_BUBBLE_ENABLED=1

# ---- herdr-bridge.mjs (sh herdr-bridge-install.sh 로 켠다): 말풍선 버튼 → 그 세션으로 · 다른 컴퓨터(herdr 저장 머신) 세션 알림 ----
# 세션으로 갈 때 앞으로 띄울 터미널 앱(비우면 돌고 있는 WezTerm·Ghostty·iTerm 등에서)
#AGENT_BUBBLE_TERMINAL=WezTerm
# 볼 머신(herdr machine list 의 label, 쉼표로 여럿). 비우면 켜 둔 저장 머신 전부
#AGENT_BUBBLE_MACHINES=company
# 몇 ms 마다 물을지(최소 2000)
#AGENT_BUBBLE_MACHINE_POLL_MS=5000
