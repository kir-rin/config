{
  "$schema": "https://opencode.ai/config.json",
	"plugin": [
		"opencode-cursor-auth@1.0.16"
	],
	"provider": {
    "cursor": {
      "npm": "@ai-sdk/openai-compatible",
      "name": "Cursor Agent (local)",
      "options": {
        "baseURL": "http://127.0.0.1:32123/v1"
      },
      "models": {
        "auto": { "name": "Cursor Agent Auto" },
        "composer-1": { "name": "Composer-1" },
        "gpt-5": { "name": "Cursor Agent GPT-5 (alias → gpt-5.2)" },
        "gpt-5.2": { "name": "Cursor Agent GPT-5.2" },
        "gpt-5.1": { "name": "Cursor Agent GPT-5.1" },
        "gpt-5.1-codex": { "name": "Cursor Agent GPT-5.1 Codex" },
        "sonnet-4.5": { "name": "Cursor Agent Sonnet 4.5" },
        "sonnet-4.5-thinking": { "name": "Cursor Agent Sonnet 4.5 Thinking" }
      }
    }
  },
	"keybinds" : {
		"leader": "ctrl+o",
		"session_list": "<leader>l",
		"messages_page_up": "ctrl+k",
		"messages_page_down": "ctrl+j",
		"command_list": "ctrl+p",
		"messages_copy": "<leader>y"
	},
	"mcp": {
		"context7": {
			"type": "remote",
			"url": "https://mcp.context7.com/mcp",
			"enabled": true
		},
		"deepwiki": {
			"type": "remote",
			"url": "https://mcp.deepwiki.com/mcp",
			"enabled": true
		},
		"chrome-devtools": {
			"type": "local",
			"command": ["npx", "-y", "chrome-devtools-mcp@latest"],
			"enabled" : true
    },
		"slack": {
			"type": "local",
			"command": ["npx", "-y", "slack-mcp-server@latest", "--transport", "stdio"],
			"enabled": true,
			"environment": {
				"SLACK_MCP_XOXP_TOKEN": "${SLACK_MCP_XOXP_TOKEN}"
			}
		},
		"atlassian": {
			"type": "local",
			"command": ["uvx", "mcp-atlassian"],
			"enabled": true,
			"env": {
				"CONFLUENCE_URL": "${CONFLUENCE_BASE_URL}",
				"CONFLUENCE_USERNAME": "${CONFLUENCE_USER_EMAIL}",
				"CONFLUENCE_API_TOKEN": "${CONFLUENCE_API_TOKEN}",
				"READ_ONLY_MODE": "true"
			}
		}
	},
	"permission": {
		"mcp_confluence_search": "allow",
		"mcp_confluence_get_page": "allow",
		"mcp_confluence_get_page_by_title": "allow",
		"mcp_confluence_get_page_ancestors": "allow",
		"mcp_confluence_get_child_pages": "allow",
		"mcp_confluence_get_spaces": "allow",
		"mcp_confluence_get_space": "allow",
		"mcp_confluence_search_pages": "allow",
		"mcp_confluence_get_page_comments": "allow",
		"mcp_confluence_get_page_labels": "allow",
		"mcp_confluence_get_page_attachments": "allow",
		"mcp_confluence_get_page_versions": "allow",
		"mcp_confluence_get_page_views": "allow",
		"mcp_confluence_get_current_user": "allow",
		"mcp_confluence_create_page": "deny",
		"mcp_confluence_update_page": "deny",
		"mcp_confluence_delete_page": "deny",
		"mcp_confluence_add_comment": "ask",
		"mcp_confluence_add_label": "ask",
		"mcp_jira_search": "allow",
		"mcp_jira_get_issue": "allow",
		"mcp_jira_get_all_projects": "allow",
		"mcp_jira_get_all_project_statuses": "allow",
		"mcp_jira_get_transitions": "allow",
		"mcp_jira_search_fields": "allow",
		"mcp_jira_get_agile_boards": "allow",
		"mcp_jira_get_board_issues": "allow",
		"mcp_jira_get_sprints": "allow",
		"mcp_jira_get_sprint_issues": "allow",
		"mcp_jira_create_issue": "deny",
		"mcp_jira_update_issue": "deny",
		"mcp_jira_delete_issue": "deny",
		"mcp_jira_transition_issue": "deny"
	}
}
